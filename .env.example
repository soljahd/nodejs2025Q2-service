PORT=4000

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=music_db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:$5432/music_db

# Secret
CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# Logging
LOG_LEVEL=debug
MAX_LOG_FILE_SIZE_KB=1024
